{
  "name": "netupdate",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cli": "cargo build --release --bin netupdate-cli --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
